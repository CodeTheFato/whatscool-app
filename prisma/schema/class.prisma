// ==================== CLASSES, SUBJECTS & SCHEDULES ====================
// Turmas, Disciplinas e Horários

model Class {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  name         String
  grade        String // "1st Grade", "2nd Grade", etc.
  shift        Shift
  academicYear Int      @map("academic_year")
  maxStudents  Int      @default(30) @map("max_students")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classTeachers ClassTeacher[]
  students      Student[]
  attendances   Attendance[]
  activities    Activity[]
  schedules     Schedule[]
  announcements Announcement[]

  @@unique([schoolId, name, academicYear])
  @@index([schoolId, academicYear])
  @@map("classes")
}

enum Shift {
  MORNING
  AFTERNOON
  EVENING
  FULL_TIME
}

model Subject {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  name        String
  description String?
  workload    Int // Hours per week
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classTeachers ClassTeacher[]
  grades        Grade[]
  activities    Activity[]
  attendances   Attendance[]
  schedules     Schedule[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("subjects")
}

// ==================== CLASS-TEACHER JUNCTION ====================
// Vínculo Professor ↔ Turma ↔ Disciplina

enum ClassTeacherRole {
  MAIN
  SUBJECT
  ASSISTANT
}

model ClassTeacher {
  id        String           @id @default(uuid())
  schoolId  String           @map("school_id")
  classId   String           @map("class_id")
  teacherId String           @map("teacher_id")
  subjectId String?          @map("subject_id")
  role      ClassTeacherRole @default(SUBJECT)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  // Relations
  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id])

  @@unique([classId, teacherId, subjectId])
  @@index([schoolId, classId])
  @@index([schoolId, teacherId])
  @@map("class_teachers")
}

model Schedule {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  classId   String   @map("class_id")
  subjectId String   @map("subject_id")
  teacherId String   @map("teacher_id")
  dayOfWeek Int      @map("day_of_week") // 0 = Sunday, 1 = Monday, etc.
  startTime String   @map("start_time") // "08:00"
  endTime   String   @map("end_time") // "09:00"
  room      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, dayOfWeek, startTime])
  @@index([schoolId, teacherId])
  @@map("schedules")
}
