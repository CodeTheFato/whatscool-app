// ==================== ACADEMIC ====================
// Frequência, Atividades e Agenda Escolar

model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  year      Int
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes Class[]

  @@unique([schoolId, year])
  @@map("academic_years")
}

model Attendance {
  id        String           @id @default(uuid())
  schoolId  String           @map("school_id")
  studentId String           @map("student_id")
  classId   String           @map("class_id")
  teacherId String           @map("teacher_id")
  subjectId String?          @map("subject_id")
  date      DateTime
  status    AttendanceStatus
  comments  String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  // Relations
  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id])

  @@unique([studentId, classId, subjectId, date])
  @@index([schoolId, date])
  @@map("attendances")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// ==================== AGENDA ESCOLAR ====================

enum ActivityType {
  HOMEWORK // Lição de casa
  NOTE     // Recado do professor
  EVENT    // Evento ou atividade especial
}

model Activity {
  id             String       @id @default(uuid())
  schoolId       String       @map("school_id")
  teacherId      String       @map("teacher_id")
  classId        String       @map("class_id")
  subjectId      String?      @map("subject_id")
  title          String
  description    String       @db.Text
  type           ActivityType @default(HOMEWORK)
  dueDate        DateTime?    @map("due_date")
  maxScore       Float?       @map("max_score")
  sendToParents  Boolean      @default(false) @map("send_to_parents")
  notifyWhatsapp Boolean      @default(false) @map("notify_whatsapp")
  aiGenerated    Boolean      @default(false) @map("ai_generated")
  publishedAt    DateTime?    @map("published_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // Relations
  school     School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher    Teacher             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class      Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject    Subject?            @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  recipients ActivityRecipient[]

  @@index([schoolId, subjectId])
  @@index([schoolId, dueDate])
  @@index([schoolId, type])
  @@index([schoolId, classId])
  @@map("activities")
}

model ActivityRecipient {
  id         String           @id @default(uuid())
  activityId String           @map("activity_id")
  userId     String           @map("user_id")
  provider   DeliveryProvider @default(PLATFORM)
  status     DeliveryStatus   @default(PENDING)
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  // Relations
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId, provider])
  @@index([userId, status])
  @@map("activity_recipients")
}
